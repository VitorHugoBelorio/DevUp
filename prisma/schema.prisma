generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  short_text
  long_text
  number
  scale
  single_select
  multi_select
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum MagicLinkPurpose {
  LOGIN
  VERIFY_EMAIL
}

enum AccessEventType {
  MAGIC_LINK_REQUESTED
  MAGIC_LINK_SENT
  LOGIN_SUCCESS
  LOGIN_BLOCKED
  LOGOUT
  ADMIN_UPDATED_USER
}

enum KnowledgeResourceType {
  platform
  article
  blog
  documentation
  course
  video
  community
  tool
  other
}

enum KnowledgeResourceLevel {
  beginner
  intermediate
  advanced
}

enum ResourceInteractionStatus {
  VIEWED
  OPENED
  SAVED
  DISMISSED
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerifiedAt DateTime?
  role            UserRole         @default(USER)
  status          UserStatus       @default(ACTIVE)
  sessions        UserSession[]
  magicLinks      MagicLinkToken[]
  diagnostics     Diagnostic[]
  accessLogs      AccessLog[]
  resourceInteractions UserResourceInteraction[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([email])
  @@index([role, status])
}

model AccessLog {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  type      AccessEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MagicLinkToken {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  email      String
  purpose    MagicLinkPurpose
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Diagnostic {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  formId           String?
  form             DiagnosticForm? @relation(fields: [formId], references: [id], onDelete: SetNull)
  input            Json
  formSnapshot     Json?
  questionSnapshot Json
  aiResult         Json
  aiModel          String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([createdAt])
  @@index([userId])
  @@index([formId])
}

model DiagnosticForm {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  isActive    Boolean              @default(false)
  isArchived  Boolean              @default(false)
  questions   DiagnosticQuestion[]
  diagnostics Diagnostic[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, isArchived])
}

model DiagnosticQuestion {
  id          String         @id @default(cuid())
  formId      String         @default("default-diagnostic-form")
  form        DiagnosticForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  key         String
  label       String
  description String?
  placeholder String?
  type        QuestionType
  required    Boolean        @default(true)
  options     Json?
  step        String
  order       Int
  aiHint      String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([formId, key])
  @@index([isActive, order])
  @@index([formId, order])
}

model KnowledgeFlag {
  id          String                  @id @default(cuid())
  key         String                  @unique
  label       String
  description String?
  resources   KnowledgeResourceFlag[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model KnowledgeResource {
  id               String                    @id @default(cuid())
  title            String
  subject          String
  url              String                    @unique
  type             KnowledgeResourceType
  level            KnowledgeResourceLevel    @default(beginner)
  description      String
  sourceName       String?
  estimatedMinutes Int?
  priority         Int                       @default(0)
  isActive         Boolean                   @default(true)
  isMainTrack      Boolean                   @default(false)
  isOutdated       Boolean                   @default(false)
  publishedAt      DateTime?
  lastCheckedAt    DateTime?
  flags            KnowledgeResourceFlag[]
  interactions     UserResourceInteraction[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([isActive, priority])
  @@index([isActive, isMainTrack, isOutdated])
  @@index([level])
  @@index([subject])
}

model KnowledgeResourceFlag {
  resourceId String
  flagId     String
  resource   KnowledgeResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  flag       KnowledgeFlag     @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@id([resourceId, flagId])
  @@index([flagId])
}

model UserResourceInteraction {
  id          String                    @id @default(cuid())
  userId      String
  resourceId  String
  status      ResourceInteractionStatus @default(VIEWED)
  viewedAt    DateTime?
  clickedAt   DateTime?
  savedAt     DateTime?
  dismissedAt DateTime?
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    KnowledgeResource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@index([status])
}
